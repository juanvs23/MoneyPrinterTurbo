# =============================================================================
# Environment overrides for MoneyPrinterTurbo.
#
# Copy this file to `.env` next to `config.toml` and fill in what you need.
# `.env` is excluded by .gitignore and must never be committed.
#
# HOW IT WORKS
#   Every key in config.toml can be supplied here instead. The environment wins
#   over the file, and these values are NEVER written back to config.toml, so a
#   secret that lives here stays here.
#
#   Canonical names are prefixed so they cannot collide with unrelated
#   variables of the host:
#     log_level            -> MPT_LOG_LEVEL
#     [app] gemini_api_key -> MPT_APP_GEMINI_API_KEY
#     [whisper] model      -> MPT_WHISPER_MODEL
#
#   The unprefixed name also works for provider-qualified keys, because the
#   codebase already reads several variables that way:
#     MPT_APP_GEMINI_API_KEY or GEMINI_API_KEY
#     MPT_APP_COVERR_API_KEYS or COVERR_API_KEYS
#
#   Generic keys without a provider prefix need the MPT_ form, so they cannot
#   hijack an unrelated variable:
#     MPT_APP_API_KEY          (the API key that protects /api/v1 and /tasks)
#     MPT_APP_VIDEO_SOURCE
#
#   The file is loaded from the runtime root. Override the location with
#   MPT_ENV_FILE=/path/to/other.env.
#
# TYPES
#   The type follows the value in config.toml: lists are comma-separated
#   (COVERR_API_KEYS=key-1,key-2), booleans accept 1/0/true/false/yes/no/on/off,
#   and integers and floats are parsed. A malformed value is reported in the
#   log and ignored, so one typo does not stop the application.
# =============================================================================


# -----------------------------------------------------------------------------
# LLM provider
# -----------------------------------------------------------------------------

# Which provider writes the script and the search keywords.
# Options include: gemini, moonshot, openai_codex, openai_chatgpt, ollama,
# claude_code, deepseek, qwen, groq, litellm, oneapi and many more.
MPT_APP_LLM_PROVIDER=gemini

# Google Gemini. Create a key at https://aistudio.google.com/app/apikey
# The default model is gemini-3.1-pro-preview; set it only to override.
MPT_APP_GEMINI_API_KEY=
# MPT_APP_GEMINI_MODEL_NAME=gemini-3.1-pro-preview

# Moonshot / Kimi. Create a key at https://platform.kimi.com
# MPT_APP_MOONSHOT_API_KEY=

# A local Ollama server needs no key at all.
# MPT_APP_LLM_PROVIDER=ollama
# MPT_APP_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1


# -----------------------------------------------------------------------------
# Material source
# -----------------------------------------------------------------------------

# Where the footage comes from. Options: local, coverr, pixabay, pexels,
# openai_image, codex_image, wavespeed, volcengine_seedance, ofox,
# metaso_minimax, muapi, loomloom, infistar, jalapeno.
#
# "local" is the default: it uses your own footage and needs no API key, no
# account and no per-video cost. Put the files in the "local_videos" directory
# of the runtime root (storage/local_videos in a source checkout), or upload
# them from the WebUI material picker.
#
# Accepted formats: .mp4 .mov .avi .flv .mkv .webm, plus .jpg .jpeg .png .bmp
# for still images. The shorter side of every file must be at least 480px
# (470px with the tolerance the renderer allows), otherwise the material is
# skipped.
MPT_APP_VIDEO_SOURCE=local

# Stock footage alternatives. Each one needs its own key.
#
# Coverr: https://coverr.co/developers
#   The key is issued instantly from Profile -> API, with no credit card.
#   The free tier allows 50 calls per hour. The library filters vertical
#   footage natively, which suits 9:16 output.
#   MPT_APP_COVERR_API_KEYS=
#
# Pixabay: https://pixabay.com/api/docs/
#   100 requests per minute on the free tier. Responses must be cached for
#   24 hours, which the runtime already does for every stock source.
#   MPT_APP_PIXABAY_API_KEYS=
#
# Pexels: https://www.pexels.com/api/
#   PAUSED. Pexels stopped issuing new API keys on 2026-09-30, with no
#   reopening date. Keys issued before that date keep working. There is
#   nothing to configure while the pause lasts.
#   MPT_APP_PEXELS_API_KEYS=


# -----------------------------------------------------------------------------
# API server
# -----------------------------------------------------------------------------

# Protects the API routes and the generated files under /tasks. Leave empty
# for the local, unauthenticated default.
MPT_APP_API_KEY=

# The service must listen on 0.0.0.0 inside a container; the port is published
# to the host separately, and every Compose file publishes on 127.0.0.1 only.
# MPT_LISTEN_HOST=0.0.0.0
# MPT_LISTEN_PORT=8080
# MPT_LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# Voice, subtitles and music
# -----------------------------------------------------------------------------

# "edge" needs no account and no key. "whisper" runs locally but downloads the
# model on first use.
MPT_APP_SUBTITLE_PROVIDER=edge

# Background music: "random" picks one of the bundled tracks.
# MPT_APP_BGM_TYPE=random
